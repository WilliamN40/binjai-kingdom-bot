# ═══════════════════════════════════════════════════════════════
# Claudegram Configuration
# ═══════════════════════════════════════════════════════════════

# ── Core ──────────────────────────────────────────────────────
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Owners: Telegram user IDs allowed to use the private-chat assistant and to
# enable groups. Optional. Leave empty and claim ownership instead: on first
# start the log prints a one-time code, and you send "/claim <code>" to the bot.
# ALLOWED_USER_IDS=123456789

# If this token is still connected to another service's webhook, disconnect it
# and receive messages here instead (true/false)
# TELEGRAM_TAKE_OVER_WEBHOOK=false

# ── Claude ────────────────────────────────────────────────────
# Use ONE of these. Without either, the bot relies on a Claude Code login on this machine.
# Anthropic API key (billed per use)
# ANTHROPIC_API_KEY=sk-ant-...
# Claude subscription token from `claude setup-token`
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Default model for private chats and the group secretary
# CLAUDE_MODEL=claude-opus-5-5

# ── Group secretary ───────────────────────────────────────────
# Groups are enabled by an owner sending /enable in the group.
# Optional: pre-approve group chat IDs here instead.
# ALLOWED_GROUP_IDS=-1001234567890

# Where transcripts, notes, schedules and bot state are stored
# DATA_DIR=./data

# Timezone for transcript timestamps, daily files and reminders
# SECRETARY_TIMEZONE=Asia/Singapore

# Model and effort for group answers (empty model = CLAUDE_MODEL)
# SECRETARY_MODEL=
# SECRETARY_EFFORT=medium

# Extra house rules for the secretary's replies, in plain words
# SECRETARY_INSTRUCTIONS="Keep a formal tone. Reply in Bahasa Indonesia unless asked otherwise."

# Let the secretary search the web (true/false)
# SECRETARY_WEB_SEARCH=true

# Attach the photo when someone asks about an image (true/false)
# SECRETARY_VISION=true

# How much recent transcript goes straight into each prompt, in characters.
# Older history is searched on demand.
# SECRETARY_CONTEXT_CHARS=40000

# Answers running at the same time; further questions wait their turn
# SECRETARY_MAX_CONCURRENT=4
# SECRETARY_MAX_TURNS=80
# SECRETARY_TIMEOUT_MS=1200000

# Reminders and recurring tasks (true/false), and their guard rails
# SECRETARY_SCHEDULES=true
# SECRETARY_MIN_REPEAT_MINUTES=15
# SECRETARY_MAX_SCHEDULES_PER_GROUP=100

# Hooks: scripts in the sandbox that react to every message (true/false)
# SECRETARY_HOOKS=true
# How often per hour hooks may hand a message to the secretary (the only hook action that uses Claude)
# SECRETARY_HOOK_ASKS_PER_HOUR=30
# Scheduled scripts use no Claude and may repeat this often (minutes)
# SECRETARY_MIN_SCRIPT_REPEAT_MINUTES=5

# Daily digests for long-term recall, written by a small model (true/false)
# SECRETARY_DIGESTS=true
# SECRETARY_DIGEST_MODEL=claude-haiku-5-5

# Weekly backup of all records, sent to the owners' private chats (true/false)
# SECRETARY_BACKUPS=true

# MCP servers every group gets without adding them, as "name=command; other=command".
# The commands must exist in the sandbox image. "ntubus" (live NTU campus shuttle buses:
# arrivals, trip planning, bus positions, arrival alerts) ships with it.
# SECRETARY_BUILTIN_MCP="ntubus=ntubus mcp"

# The bot's own repository. When set, the secretary can propose changes to itself as pull requests.
# BOT_REPO_URL=https://github.com/you/your-fork

# GitHub token available inside the sandbox (git and gh). Everyone in an enabled group can
# use it through the secretary, so make it a fine-grained token limited to the repositories
# and permissions those people already have.
# SANDBOX_GITHUB_TOKEN=github_pat_...

# Sandbox: unix socket of the sandbox runner. Set by docker-compose.yml.
# Leave empty to run without the run-command / file tools.
# SANDBOX_SOCKET=/run/sandbox/runner.sock
# Disk quota per group workspace, in MB (read by docker-compose.yml)
# SANDBOX_QUOTA_MB=8192

# Each group gets its own Linux machine (root, apt, background services) under gVisor.
# Needs runsc registered in Docker, deploy/workbench-firewall.sh on the host, and
# `docker compose --profile image build workbench-image`. See README.
# SANDBOX_BACKEND=workbench
# HOST_DATA_DIR=/absolute/path/to/this/folder/data
# SANDBOX_DOCKER_SOCKET=/var/run/docker.sock

# Let the owner deploy a confirmed commit from the chat with /deploy
# (install the host side once with: sudo bash deploy/install-deployer.sh)
# DEPLOY_FROM_CHAT=true

# Optional: explicit .env path (useful if you start the bot from another directory)
# CLAUDEGRAM_ENV_PATH=/absolute/path/to/claudegram/.env

# Path to the Claude Code CLI executable
# Default: "claude" (assumes it's in your PATH)
# CLAUDE_EXECUTABLE_PATH=/home/username/.local/bin/claude

# Use SDK bundled executable for agent queries (true/false)
# CLAUDE_USE_BUNDLED_EXECUTABLE=true

# SDK log level: off | basic | verbose | trace
# CLAUDE_SDK_LOG_LEVEL=basic

# Include partial streaming events in SDK output (true/false)
# CLAUDE_SDK_INCLUDE_PARTIAL=false

# Append a safe reasoning summary to each response (true/false)
# CLAUDE_REASONING_SUMMARY=true

# Bot personality name used in the system prompt
# BOT_NAME=Claudegram

# Bot run mode (used by /restartbot and /botstatus)
# BOT_MODE=prod

# ── Workspace ─────────────────────────────────────────────────
# Root directory shown in /project picker
# Default: $HOME
# WORKSPACE_DIR=/home/username/projects

# ── Response Behavior ─────────────────────────────────────────
# "streaming" = live-updating messages, "wait" = send when complete
STREAMING_MODE=streaming

# Debounce interval (ms) for streaming message edits
STREAMING_DEBOUNCE_MS=500

# Max characters per message chunk (Telegram limit is 4096)
MAX_MESSAGE_LENGTH=4096

# ── Telegraph (Instant View) ─────────────────────────────────
# When enabled, long responses (>2500 chars) are published to Telegraph
# and displayed as Instant View pages for better readability.
# When disabled, long responses are sent as multiple chunked messages.
TELEGRAPH_ENABLED=true

# ── Dangerous Mode ────────────────────────────────────────────
# Auto-approve all Claude tool permissions (use with caution!)
DANGEROUS_MODE=false

# Max iterations for /loop command
MAX_LOOP_ITERATIONS=5

# Allow private network URLs for /vreddit (true/false)
# Default: false (blocks localhost and RFC1918 ranges)
ALLOW_PRIVATE_NETWORK_URLS=false

# ── Reddit Integration ────────────────────────────────────────
# Native TypeScript module — no external Python dependency required
# Create a "script" app at https://www.reddit.com/prefs/apps/
#
# WARNING: Reddit's script-app OAuth requires the actual account password.
# Use a dedicated bot account — NOT your personal Reddit credentials.

# Enable /reddit command (set false to disable)
REDDIT_ENABLED=true

# Reddit API credentials (for native TypeScript module)
# ⚠️ Use a dedicated bot account - do not use your primary Reddit account
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_PASSWORD=
REDDIT_USERNAME=

# Execution timeout (ms)
REDDITFETCH_TIMEOUT_MS=30000

# Default --limit when not specified by user
REDDITFETCH_DEFAULT_LIMIT=10

# Default comment --depth for posts
REDDITFETCH_DEFAULT_DEPTH=5
# If markdown output exceeds this many characters, auto-save JSON instead
REDDITFETCH_JSON_THRESHOLD_CHARS=8000

# Reddit video: max size for /vreddit downloads
# Enable /vreddit downloads (set false to disable)
VREDDIT_ENABLED=true

# REDDIT_VIDEO_MAX_SIZE_MB=50

# ── Medium / Freedium ─────────────────────────────────────────
# Fetches Medium articles via Freedium mirror (no Python/Playwright needed)

# Enable /medium command (set false to disable)
MEDIUM_ENABLED=true

# Freedium mirror host (default: freedium-mirror.cfd)
# FREEDIUM_HOST=freedium-mirror.cfd

# Rate limit between Freedium requests (ms)
# FREEDIUM_RATE_LIMIT_MS=2000

# Fetch timeout (ms)
# MEDIUM_TIMEOUT_MS=15000

# If markdown exceeds this many chars, offer to save as file
# MEDIUM_FILE_THRESHOLD_CHARS=8000

# Enable terminal-style UI by default (animated spinners, tool status)
TERMINAL_UI_DEFAULT=false

# Image Uploads
# Max image file size in MB (Telegram limit ~20MB for downloads)
IMAGE_MAX_FILE_SIZE_MB=20
