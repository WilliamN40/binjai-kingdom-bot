{
  "name": "claudegram",
  "version": "2.0.0",
  "description": "Telegram bot that bridges messages to Claude Code, with a group secretary mode that records group conversations and answers questions about them",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "keywords": [
    "telegram",
    "claude",
    "bot",
    "ai",
    "agent"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.332",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/runner": "^2.0.3",
    "@types/turndown": "^5.0.6",
    "cheerio": "^1.2.0",
    "croner": "^11.0.1",
    "dotenv": "^18.0.10",
    "grammy": "^1.48.0",
    "https-proxy-agent": "^9.1.0",
    "telegram-markdown-v2": "^0.0.4",
    "turndown": "^7.2.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
